{
  "name": "cpp-pet-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @cpp-pet/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "test:e2e": "pnpm --filter @cpp-pet/desktop build && node node_modules/@playwright/test/cli.js test",
    "package:nsis": "pnpm --filter @cpp-pet/desktop package:nsis"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^43.1.0"
  }
}
