{
  "name": "cpp-pet-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm native:electron && pnpm --filter @cpp-pet/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "native:node": "pnpm --filter @cpp-pet/database rebuild better-sqlite3 --config.build-from-source=true",
    "native:electron": "pnpm --filter @cpp-pet/desktop exec electron-builder install-app-deps",
    "test": "pnpm native:node && pnpm -r test",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "test:e2e": "pnpm --filter @cpp-pet/desktop build && pnpm native:electron && playwright test",
    "package:dir": "pnpm native:electron && pnpm --filter @cpp-pet/desktop package:dir"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^43.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "electron", "esbuild"]
  }
}
